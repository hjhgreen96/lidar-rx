# lidar-rx 실행 인자 (lidar-rx.service가 읽음 → /etc/lidar-rx/lidar-rx.env)
#   --rcvbuf 1048576  커널이 두 배로 잡아 2 MB ≈ 패킷 910개 ≈ 1.2초를 버팀 (실험 1). rmem_max가 1 MB 이상이어야 함 (sysctl.d)
#   --status 10       상태 한 줄을 10초마다 (journald와 systemctl status로)
#   --cpu 1 --rt-prio 50   수신 스레드 하나만 CPU 1에 고정하고 SCHED_FIFO 50 (실험 4)
#   --ros2            /velodyne_points 발행. ROS 2가 없는 보드에서는 뺀다
#   --lock-memory     mlockall(MCL_CURRENT | MCL_FUTURE): 코드·스택·힙과 앞으로 받을 메모리를 RAM에 고정 (수신 스레드가 SD
#                     카드 읽기를 기다리지 않게). 보드(ROS 2 없음)에서 켬: 고정 약 5.0 ~ 7.7 MB. 여기(--ros2)서는 끔: DDS 메모리까지 LimitMEMLOCK=64M을
#                     넘어 mlockall이 실패함 (WSL 실측, docs/runs/5-board.md 11절)
LIDAR_RX_ARGS=--udp 0.0.0.0:2368 --rcvbuf 1048576 --status 10 --cpu 1 --rt-prio 50 --ros2
